# Frontend
VITE_VERSION=1.0.0
VITE_API_URL=https://api.spectrum.utile.space
VITE_PUBLIC_URL=https://spectrum.utile.space
# Set to 'true' to enable debug logging in the browser console (default: false)
VITE_DEBUG=false

# Backend
API_PORT=3000
API_VERSION=1.0.0
# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# v2 room defaults
SPECTRUM_PARTICIPANT_SLOTS=6
SPECTRUM_SPECTATOR_LIMIT=50
SPECTRUM_SPECTATOR_CHAT=false
SPECTRUM_TRANSCRIPTION_ENABLED=true
